<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseWindowsForms>true</UseWindowsForms>
    <OutputType>Library</OutputType>
    <AssemblyName>GTA5AutoPilot</AssemblyName>
    <RootNamespace>GTA5AutoPilot</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="ScriptHookVDotNet3">
      <HintPath>..\deps\ScriptHookVDotNet3.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="LLamaSharp" Version="0.11.2" />
    <PackageReference Include="LLamaSharp.Backend.Cpu" Version="0.11.2" />
  </ItemGroup>

  <!-- Remove conflicting System.* assemblies that ship with NuGet packages.
       GTA V loads its own .NET Framework 4.8 versions; overriding them causes crashes. -->
  <Target Name="RemoveConflictingAssemblies" AfterTargets="Build">
    <ItemGroup>
      <ConflictingFiles Include="$(OutputPath)System.Memory.dll" />
      <ConflictingFiles Include="$(OutputPath)System.Buffers.dll" />
      <ConflictingFiles Include="$(OutputPath)System.Numerics.Vectors.dll" />
      <ConflictingFiles Include="$(OutputPath)System.Runtime.CompilerServices.Unsafe.dll" />
    </ItemGroup>
    <Delete Files="@(ConflictingFiles)" />
  </Target>


</Project>
